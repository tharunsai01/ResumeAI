# Docker Compose settings. Copy to .env and replace every "change-me" value.
# Generate secrets with: openssl rand -base64 48

MONGO_ROOT_USER=hiresmart
MONGO_ROOT_PASSWORD=change-me-mongo-password

JWT_ACCESS_SECRET=change-me-at-least-32-characters-access
JWT_REFRESH_SECRET=change-me-at-least-32-characters-refresh
AI_SERVICE_TOKEN=change-me-shared-backend-to-ai-token

# Optional: Groq LLM for richer extraction. Without it the AI service uses
# deterministic parsing; scores are identical either way.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Set to false to skip downloading MiniLM at build time (TF-IDF fallback is used)
PRELOAD_MODEL=true
EMBEDDINGS_ENABLED=true

PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080

# Optional social sign-in (redirect URI: ${PUBLIC_URL}/api/v1/auth/oauth/<provider>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Allow `node dist/seed/seed.js` inside the production-mode container (demo environments only)
SEED_ALLOW_PRODUCTION=true
