# =============================================================
# HireSmart AI - Global Environment Configuration Reference
# =============================================================

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hiresmart
CLIENT_URL=http://localhost:5173

# --- Authentication & Secrets ---
JWT_ACCESS_SECRET=hiresmart_jwt_access_super_secret_key_2026_xyz
JWT_REFRESH_SECRET=hiresmart_jwt_refresh_super_secret_key_2026_abc
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- AI microservice and provider (server-side only) ---
AI_SERVICE_KEY=
# Generate a shared key with openssl rand -hex 24.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=

# --- Optional Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="HireSmart AI <no-reply@hiresmart.local>"

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_USE_MOCK=false

# Optional OAuth credentials for the Docker backend. Register the exact callback with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
