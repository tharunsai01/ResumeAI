ENVIRONMENT=development
# Must match AI_SERVICE_TOKEN in backend/.env
INTERNAL_SERVICE_TOKEN=change-me-long-random-string
# Optional. Without a key the service uses deterministic extraction only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_ENABLED=true
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_FILE_MB=5
