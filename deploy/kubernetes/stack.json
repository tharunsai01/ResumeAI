{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "mongo-data",
        "labels": {
          "app": "mongo-data"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "resume-uploads",
        "labels": {
          "app": "resume-uploads"
        }
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "mongodb",
        "labels": {
          "app": "mongodb"
        }
      },
      "spec": {
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "mongodb"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "mongodb"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "mongodb",
                "image": "mongo:7.0",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 27017
                  }
                ],
                "env": [],
                "volumeMounts": [
                  {
                    "name": "mongo-data",
                    "mountPath": "/data/db"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "mongo-data",
                "persistentVolumeClaim": {
                  "claimName": "mongo-data"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "mongodb",
        "labels": {
          "app": "mongodb"
        }
      },
      "spec": {
        "selector": {
          "app": "mongodb"
        },
        "ports": [
          {
            "port": 27017,
            "targetPort": 27017
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "ai-service",
        "labels": {
          "app": "ai-service"
        }
      },
      "spec": {
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "ai-service"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "ai-service"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "ai-service",
                "image": "resumeai-capstone-ai-service:latest",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 8000
                  }
                ],
                "env": [
                  {
                    "name": "GROQ_MODEL",
                    "value": "openai/gpt-oss-20b"
                  },
                  {
                    "name": "AI_SERVICE_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "resumeai-secrets",
                        "key": "AI_SERVICE_KEY"
                      }
                    }
                  },
                  {
                    "name": "GROQ_API_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "resumeai-secrets",
                        "key": "GROQ_API_KEY"
                      }
                    }
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8000
                  },
                  "periodSeconds": 3,
                  "failureThreshold": 40
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 8000
                  },
                  "periodSeconds": 5
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "ai-service",
        "labels": {
          "app": "ai-service"
        }
      },
      "spec": {
        "selector": {
          "app": "ai-service"
        },
        "ports": [
          {
            "port": 8000,
            "targetPort": 8000
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "backend",
        "labels": {
          "app": "backend"
        }
      },
      "spec": {
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "backend"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "backend"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "backend",
                "image": "resumeai-capstone-backend:latest",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 5000
                  }
                ],
                "env": [
                  {
                    "name": "NODE_ENV",
                    "value": "production"
                  },
                  {
                    "name": "MONGODB_URI",
                    "value": "mongodb://mongodb:27017/hiresmart"
                  },
                  {
                    "name": "AI_SERVICE_URL",
                    "value": "http://ai-service:8000"
                  },
                  {
                    "name": "PORT",
                    "value": "5000"
                  },
                  {
                    "name": "AI_SERVICE_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "resumeai-secrets",
                        "key": "AI_SERVICE_KEY"
                      }
                    }
                  },
                  {
                    "name": "JWT_ACCESS_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "resumeai-secrets",
                        "key": "JWT_ACCESS_SECRET"
                      }
                    }
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 5000
                  },
                  "periodSeconds": 3,
                  "failureThreshold": 40
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health",
                    "port": 5000
                  },
                  "periodSeconds": 5
                },
                "volumeMounts": [
                  {
                    "name": "resume-uploads",
                    "mountPath": "/app/uploads"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "resume-uploads",
                "persistentVolumeClaim": {
                  "claimName": "resume-uploads"
                }
              }
            ],
            "securityContext": {
              "fsGroup": 1000
            }
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "backend",
        "labels": {
          "app": "backend"
        }
      },
      "spec": {
        "selector": {
          "app": "backend"
        },
        "ports": [
          {
            "port": 5000,
            "targetPort": 5000
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "frontend",
        "labels": {
          "app": "frontend"
        }
      },
      "spec": {
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "frontend"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "frontend"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "frontend",
                "image": "resumeai-capstone-frontend:latest",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 80
                  }
                ],
                "env": [],
                "startupProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 80
                  },
                  "periodSeconds": 3,
                  "failureThreshold": 40
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 80
                  },
                  "periodSeconds": 5
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "frontend",
        "labels": {
          "app": "frontend"
        }
      },
      "spec": {
        "selector": {
          "app": "frontend"
        },
        "ports": [
          {
            "port": 80,
            "targetPort": 80
          }
        ]
      }
    }
  ]
}
