NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hiresmart

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000

AI_SERVICE_URL=http://127.0.0.1:8000
# Must match INTERNAL_SERVICE_TOKEN in ai-service/.env
AI_SERVICE_TOKEN=change-me-long-random-string
AI_TIMEOUT_MS=60000

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Optional social sign-in. Leave blank to hide the buttons' functionality.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

LOG_LEVEL=info
# Number of proxy hops in front of the API (1 behind Nginx/Ingress)
TRUST_PROXY=0
AUDIT_RETENTION_DAYS=365

# Integration tests only
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/hiresmart_test
