# HireSmart AI — Frontend Environment Configuration Example
# Copy this file to .env.local to customize for local development.

# Backend REST API Base URL (Express.js Gateway v1)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# AI Service Base URL (Python FastAPI / LLM Microservice)
VITE_AI_SERVICE_URL=http://localhost:8000/api

# Mock Mode: Set to "true" to use local mock data / localStorage, or "false" to connect to backend APIs
VITE_USE_MOCK=true

# OAuth 2.0 Client IDs (Optional for client-side rendering / SDK buttons)
VITE_GOOGLE_CLIENT_ID=
VITE_LINKEDIN_CLIENT_ID=
