# Base URL of the Express API. Keep /api/v1 when the frontend is served behind
# the same origin (Vite dev proxy, Nginx, Kubernetes Ingress).
VITE_API_URL=/api/v1
# Dev server proxy target for /api
VITE_PROXY_TARGET=http://localhost:5000
# Optional footer/contact links (hidden when empty)
VITE_CONTACT_EMAIL=
VITE_GITHUB_URL=
